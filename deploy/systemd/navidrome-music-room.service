[Unit]
Description=Navidrome Music Room companion gateway
After=network-online.target navidrome.service
Wants=network-online.target

[Service]
Type=simple
User=navidrome
Group=navidrome
EnvironmentFile=/etc/navidrome-music-room/gateway.env
ExecStart=/opt/navidrome-music-room/music-room-launcher
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/navidrome/plugins
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
