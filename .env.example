PUID=1000
PGID=1000
TZ=UTC
NAVIDROME_IMAGE=deluan/navidrome:latest
NAVIDROME_BIND_ADDRESS=127.0.0.1
NAVIDROME_PORT=4533
NAVIDROME_PUBLIC_URL=https://music.example.com
MUSIC_ROOM_PUBLIC_URL=https://music.example.com/music-room
MUSIC_ROOM_ALLOWED_ORIGINS=https://music.example.com
MUSIC_ROOM_PLUGIN_PAIRING_TOKEN=replace-with-at-least-32-random-characters
MUSIC_LIBRARY_PATH=./music
# Optional absolute paths are useful for isolated validation deployments.
NAVIDROME_DATA_PATH=./data/navidrome
NAVIDROME_PLUGINS_PATH=./data/plugins
MUSIC_ROOM_IMAGE=ghcr.io/mythezone/navidrome-music-room:beta
